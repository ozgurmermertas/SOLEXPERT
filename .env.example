# Bu dosyayı kopyalayıp adını .env.local yap ve anahtarları doldur.
# .env.local asla GitHub'a gitmez.

# Solana verisi (helius.dev) — ZORUNLU
HELIUS_API_KEY=
# İsteğe bağlı ikinci Helius anahtarı (başka hesaptan). İlki 429 / overloaded / 5xx verirse
# istek bununla tekrar denenir. Boş bırakılırsa tek anahtarla çalışır.
HELIUS_API_KEY_2=

# Yapay zekâ (aistudio.google.com) — site analizi ve özet için
GOOGLE_GENERATIVE_AI_API_KEY=
# AI Studio'da ücretsiz görünen model adı (boş bırakırsan gemini-flash-latest)
GEMINI_MODEL=

# Site tarama (firecrawl.dev)
FIRECRAWL_API_KEY=

# Sesli okuma (elevenlabs.io) — 2. gün
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
